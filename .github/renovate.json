{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "nix": { "enabled": true },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "rebase"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am every day"],
    "automerge": true,
    "automergeType": "pr",
    "automergeStrategy": "rebase",
    "commitMessagePrefix": "chore(flake):",
    "addLabels": ["dependencies", "automated"]
  }
}
